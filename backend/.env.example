# 민감정보 암호화 (crypto.enabled: true로 켠 모든 서비스가 같은 키를 쓴다. 지금은 member-service, cash-service)
## openssl rand -base64 32 (휴대폰 번호 등 조회용 블라인드 인덱스 키, 다른 키와 다른 값)
CRYPTO_HMAC_KEY=
## openssl rand -base64 32
CRYPTO_PASSWORD=
## openssl rand -hex 8
CRYPTO_SALT=

# 아래 접속 정보는 compose.yml의 앱 컨테이너(member-service, cash-service, file-service, order-service, product-service, queue-service) 기준 (Docker 내부 서비스 이름 사용)
# 실제 운영 서버에 배포할 때는 운영 인프라 주소로 바꾼다

# DB 정보 (compose의 bukang-db와 동일). 아래 값은 로컬 compose용이고, 서버(EC2)에서는 바꾼다
MYSQL_HOST=bukang-db
MYSQL_PORT=3306
MYSQL_USER=bukang2
MYSQL_PASS=bukang2
MYSQL_DB=bukang-db

# cash·payout·file·order·product가 표를 만드는 방법 (compose.yml의 x-jpa-ddl-auto). 비우면 update
# 이 다섯 서비스는 아직 Flyway가 없어 빈 DB에서는 update여야 뜬다. member-service는 Flyway를 쓰므로 이 값과 상관없다
#JPA_DDL_AUTO=update

# Kafka (컨테이너용 internal 리스너)
KAFKA_BOOTSTRAP_SERVERS=bukang-kafka:29092

#elasticsearch (로컬은 보안 비활성화라 계정 없음)
ELASTICSEARCH_URIS=http://bukang-elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Redis
REDIS_HOST=bukang-redis
REDIS_PORT=6379

# JWT 서명 키 (32자 이상, openssl rand -base64 32)
JWT_SECRET=

# Toss페이먼츠 결제 승인 (cash-service, PRO-81). 운영용 시크릿 키(live_sk_로 시작)
# 비워도 앱은 뜨지만 결제 승인이 실패한다. 로컬 확인은 테스트 키(test_sk_로 시작)를 넣는다
TOSS_SECRET_KEY=

# 파일 저장소 S3 (file-service)
# 아래 값이 없으면 로컬 S3Mock을 쓴다 (bootRun은 localhost:9090, compose 앱 컨테이너는 bukang-s3mock:9090)
# 실제 AWS S3를 쓰려면 아래 7줄의 주석을 모두 풀고 값을 채운다
# 값이 빈 S3_ENDPOINT·S3_PUBLIC_ENDPOINT도 반드시 주석을 푼다. 주석으로 남기면 S3Mock 주소가 쓰여 버킷을 찾지 못한다
# 키는 로컬 확인용 IAM 사용자 키다. 운영 서버(EC2)에서는 키 대신 IAM 역할을 쓰고 두 키를 빈 값으로 둔다
#S3_BUCKET=
#AWS_REGION=ap-northeast-2
#S3_ENDPOINT=
#S3_PUBLIC_ENDPOINT=
#S3_PATH_STYLE=false
#S3_ACCESS_KEY=
#S3_SECRET_KEY=

# 프론트(web 컨테이너). compose.yml이 이 파일에서 읽는다 (프론트 설명은 frontend/.env.example)
# 아래 세 값은 빌드할 때 이미지에 고정되므로 바꾸면 docker compose --profile app up -d --build web 으로 다시 빌드한다
## next/image가 최적화를 허용할 이미지 호스트(https만, 쉼표 구분). 실제 S3를 쓰면 버킷 도메인 (예: bukang-file.s3.ap-northeast-2.amazonaws.com)
#IMAGE_REMOTE_HOSTS=
## 설정하면 next/image가 이 CDN 주소로 이미지를 요청한다
#NEXT_PUBLIC_IMAGE_CDN_URL=
## 공유 카드(og:image)의 절대 주소. 비우면 http://localhost (빌드와 실행에 같은 값을 넘긴다)
#SITE_URL=

# 운영(EC2) HTTPS. 로컬에서는 모두 비워 둔다 (compose.prod.yml 참고)
# 아래 네 줄을 채우면 docker compose up -d --build 하나로 앱을 띄우고 Let's Encrypt 인증서까지 받는다
## compose.prod.yml을 덧붙이고 앱 컨테이너(profile app)까지 띄운다. 매번 -f, --profile을 붙이지 않아도 된다
## COMPOSE_FILE을 쓰면 compose.override.yml을 자동으로 읽지 않는다. 서버에 override 파일이 있으면 가운데에 함께 적는다
##   예: COMPOSE_FILE=compose.yml:compose.override.yml:compose.prod.yml
#COMPOSE_FILE=compose.yml:compose.prod.yml
#COMPOSE_PROFILES=app
## 인증서를 받을 도메인. A 레코드가 이 서버(탄력적 IP)를 가리키고, 보안 그룹에서 80·443이 열려 있어야 한다
#DOMAIN=crewrun.duckdns.org
## Let's Encrypt 계정 이메일 (약관·계정 관련 공지를 받는다. 만료 알림 메일은 2025년부터 보내지 않는다)
## 바꾸려면 이 값만 고치고 docker compose up -d certbot 으로 다시 띄운다 (시작할 때 계정 이메일을 맞춘다)
#CERTBOT_EMAIL=
## HTTPS로 바꾸면 위 SITE_URL도 https://도메인 으로 바꾼다

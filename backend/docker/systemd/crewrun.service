# 운영 EC2가 부팅될 때 docker compose up으로 앱 전체를 순서대로 띄운다
# Docker의 restart 정책은 재부팅 때 depends_on을 무시하고 모든 컨테이너를 동시에 켠다.
# compose up은 depends_on과 healthcheck를 지켜 인프라 → 서비스 → gateway → web·nginx 순서로 띄운다
#
# 설치 (서버에서 한 번, WorkingDirectory가 실제 경로와 같은지 먼저 확인한다):
#   sudo cp docker/systemd/crewrun.service /etc/systemd/system/crewrun.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable crewrun
# 확인: systemctl status crewrun / 부팅 기록: journalctl -u crewrun -b
# 이 파일을 고치면 다시 복사하고 daemon-reload 한다

[Unit]
Description=crewrun docker compose
# Docker가 완전히 켜진 뒤에 실행하고, Docker가 없으면 실행하지 않는다
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
# 한 번 실행하고 끝나는 작업. 끝난 뒤에도 실행 중으로 취급해, 같은 부팅에서 다시 돌지 않는다
Type=oneshot
RemainAfterExit=yes
User=ubuntu
# 서버 코드 폴더의 backend. .env(COMPOSE_FILE·COMPOSE_PROFILES 등)를 여기서 읽는다
WorkingDirectory=/home/ubuntu/workspace/beadv8_1_BSB_MONO/backend
# --no-build: 서버에서 빌드하지 않고 받아 둔 이미지로 띄운다
# --wait: 모두 healthy가 될 때까지 기다리고, 아니면 이 서비스를 실패로 남긴다 (healthcheck 대기 5분 + 여유)
ExecStart=/usr/bin/docker compose up -d --no-build --wait --wait-timeout 900
TimeoutStartSec=1000

[Install]
WantedBy=multi-user.target

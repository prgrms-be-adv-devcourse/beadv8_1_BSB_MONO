# 복사해서 .env.local로 쓰세요. 설명은 src/shared/config/env.ts 참고.

# 서버가 API를 보낼 곳 (로컬 백엔드 API 게이트웨이. 게이트웨이가 경로를 보고 각 서비스로 넘긴다)
BACKEND_URL=http://localhost:8000

# on: MSW 가짜 응답 / off: BACKEND_URL로 프록시. 백엔드가 생기기 전까지는 on.
API_MOCKING=on

# 공유 카드(og:image)에 들어갈 사이트 주소. Vercel에서는 비워도 운영 주소를 씀. AWS 배포 때는 꼭 설정
# 운영 CD 빌드(app-cd.yml)는 이 파일이 아니라 저장소 Variables에서 읽는다
SITE_URL=

# next/image 최적화를 허용할 이미지 호스트 (쉼표 구분)
IMAGE_REMOTE_HOSTS=

# 설정하면 next/image가 이 CDN 주소로 직접 요청 (AWS에서 서버 CPU 아끼기용)
NEXT_PUBLIC_IMAGE_CDN_URL=

# 토스페이먼츠 결제창 클라이언트 키. 테스트 키(test_ck_로 시작)만 쓴다. 백엔드 TOSS_SECRET_KEY(test_sk_)와 같은 상점 키여야 한다
# API_MOCKING=on이면 결제창 없이 바로 충전 성공으로 넘어가므로 비워도 된다
# 운영 CD 빌드(app-cd.yml)는 이 파일이 아니라 저장소 Variables(Settings → Secrets and variables → Actions → Variables)에서 읽는다
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# Google 태그 관리자 컨테이너 ID(GTM-로 시작). 비우면 GTM을 넣지 않고 사용자 활동 이벤트도 보내지 않는다
# API_MOCKING=on이면 값이 있어도 넣지 않는다. 로컬 개발에서는 비워 둔다
# 운영 CD 빌드(app-cd.yml)는 이 파일이 아니라 저장소 Variables에서 읽는다
NEXT_PUBLIC_GTM_ID=

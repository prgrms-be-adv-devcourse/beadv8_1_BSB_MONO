{
  "openapi": "3.1.0",
  "info": {
    "title": "Bukang Cash API",
    "description": "크루 중심 마라톤 대회 예매·커머스 플랫폼 캐시 API",
    "version": "v1"
  },
  "tags": [
    {
      "name": "Cash",
      "description": "예치금 지갑 잔액 조회 API"
    }
  ],
  "paths": {
    "/api/v1/cash/withdrawals": {
      "post": {
        "tags": [
          "Cash"
        ],
        "summary": "예치금 전액 환급 신청",
        "description": "회원이 남은 예치금 전액을 환급 신청하면 한 트랜잭션에서 바로 완료 처리한다. Idempotency-Key 헤더를 멱등키로 써서 같은 요청이 여러 번 와도 한 번만 처리한다.",
        "operationId": "requestWithdrawal",
        "parameters": [
          {
            "name": "X-Member-Id",
            "in": "header",
            "description": "환급할 회원 ID (게이트웨이가 Access Token에서 넣어준다)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "exclusiveMinimum": 0
            },
            "example": 3
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "중복 환급 방지 키. 같은 [환급 신청] 재시도에는 같은 값을 보낸다 (예: UUID)",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "minLength": 1
            },
            "example": "6f1c2a7e-3b9d-4f0a-9c55-0d2e8b7a1f43"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CashWithdrawalRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "환급 신청 완료",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "환급 신청이 완료되었습니다.",
                  "data": {
                    "withdrawnAmount": 50000,
                    "balance": 0
                  }
                }
              }
            }
          },
          "400": {
            "description": "환급할 잔액 없음, 입력값 검증 실패 또는 요청 본문 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "examples": {
                  "환급할 잔액 없음": {
                    "description": "환급할 잔액 없음",
                    "value": {
                      "status": 400,
                      "message": "환급할 잔액이 없습니다.",
                      "data": null
                    }
                  },
                  "입력값 검증 실패": {
                    "description": "입력값 검증 실패",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "은행 코드를 작성해주세요.",
                      "data": null
                    }
                  },
                  "요청 본문 형식 오류": {
                    "description": "요청 본문 형식 오류",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "요청 본문 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "지갑 없음 (회원 가입 이벤트가 아직 처리되지 않았거나 없는 회원)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 404,
                  "message": "존재하지 않는 지갑입니다.",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cash/charges/confirm": {
      "post": {
        "tags": [
          "Cash"
        ],
        "summary": "충전 승인 확정",
        "description": "프론트가 Toss 결제위젯 콜백으로 받은 paymentKey·orderId·amount로 PG 승인을 확정하고, 성공하면 예치금 지갑에 반영한다. orderId를 멱등키로 써서 같은 요청이 여러 번 와도 한 번만 처리한다.",
        "operationId": "confirmWalletCharge",
        "parameters": [
          {
            "name": "X-Member-Id",
            "in": "header",
            "description": "충전할 회원 ID (게이트웨이가 Access Token에서 넣어준다)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "exclusiveMinimum": 0
            },
            "example": 3
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CashChargeConfirmRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "충전 확정 처리됨 (성공 또는 PG 승인 거절)",
            "content": {
              "application/json": {
                "examples": {
                  "충전 성공": {
                    "description": "충전 성공",
                    "value": {
                      "status": 200,
                      "message": "충전했습니다.",
                      "data": {
                        "outcome": "COMPLETED",
                        "balance": 60000
                      }
                    }
                  },
                  "PG 승인 거절": {
                    "description": "PG 승인 거절",
                    "value": {
                      "status": 200,
                      "message": "충전에 실패했습니다.",
                      "data": {
                        "outcome": "FAILED",
                        "balance": 50000
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "최소 충전 금액 미만, 입력값 검증 실패 또는 요청 본문 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "examples": {
                  "최소 충전 금액 미만": {
                    "description": "최소 충전 금액 미만",
                    "value": {
                      "status": 400,
                      "message": "최소 충전 금액은 10,000원입니다.",
                      "data": null
                    }
                  },
                  "입력값 검증 실패": {
                    "description": "입력값 검증 실패",
                    "value": {
                      "status": 400,
                      "message": "paymentKey를 작성해주세요.",
                      "data": null
                    }
                  },
                  "요청 본문 형식 오류": {
                    "description": "요청 본문 형식 오류",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "요청 본문 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "지갑 없음 (회원 가입 이벤트가 아직 처리되지 않았거나 없는 회원)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 404,
                  "message": "존재하지 않는 지갑입니다.",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cash/wallets/balance": {
      "get": {
        "tags": [
          "Cash"
        ],
        "summary": "지갑 잔액 조회",
        "description": "요청자 본인의 지갑 잔액을 조회한다.",
        "operationId": "getBalance",
        "parameters": [
          {
            "name": "X-Member-Id",
            "in": "header",
            "description": "조회할 회원 ID (게이트웨이가 Access Token에서 넣어준다)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "exclusiveMinimum": 0
            },
            "example": 3
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "잔액 조회 성공",
                  "data": {
                    "holderId": 3,
                    "balance": 50000
                  }
                }
              }
            }
          },
          "404": {
            "description": "지갑 없음 (회원 가입 이벤트가 아직 처리되지 않았거나 없는 회원)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 404,
                  "message": "존재하지 않는 지갑입니다.",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cash/wallets/ledgers": {
      "get": {
        "tags": [
          "Cash"
        ],
        "summary": "예치금 내역 조회",
        "description": "요청자 본인 지갑의 내역을 최신순으로 조회한다. category로 탭(CHARGE/PAYMENT/REFUND/WITHDRAWAL/PAYOUT)을 필터링할 수 있고, 생략하면 전체를 돌려준다.",
        "operationId": "getLedgers",
        "parameters": [
          {
            "name": "X-Member-Id",
            "in": "header",
            "description": "조회할 회원 ID (게이트웨이가 Access Token에서 넣어준다)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "exclusiveMinimum": 0
            },
            "example": 3
          },
          {
            "name": "category",
            "in": "query",
            "description": "탭 필터. 생략하면 전체",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "CHARGE",
                "PAYMENT",
                "REFUND",
                "WITHDRAWAL",
                "PAYOUT"
              ]
            },
            "example": "CHARGE"
          },
          {
            "name": "page",
            "in": "query",
            "description": "페이지 번호 (0부터)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            },
            "example": 0
          },
          {
            "name": "size",
            "in": "query",
            "description": "페이지 크기 (1~100)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            },
            "example": 20
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공 (내역이 없으면 빈 목록)",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "예치금 내역을 조회했습니다.",
                  "data": {
                    "content": [
                      {
                        "category": "CHARGE",
                        "ledgerType": "충전__PG결제_토스페이먼츠",
                        "amount": 10000,
                        "balanceAfter": 60000,
                        "createdAt": "2026-10-20T09:03:03.319058",
                        "refId": 1
                      }
                    ],
                    "page": 0,
                    "size": 20,
                    "totalElements": 1,
                    "totalPages": 1
                  }
                }
              }
            }
          },
          "400": {
            "description": "페이지·회원 ID·category 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "examples": {
                  "페이지 크기 초과": {
                    "description": "페이지 크기 초과",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "한 번에 100개까지 조회할 수 있습니다.",
                      "data": null
                    }
                  },
                  "값 형식 오류": {
                    "description": "값 형식 오류",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "요청 값의 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  },
                  "회원 ID가 0 이하": {
                    "description": "회원 ID가 0 이하",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "회원 ID가 올바르지 않습니다.",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "회원 ID 헤더 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 401,
                  "message": "로그인이 필요합니다.",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "지갑 없음 (회원 가입 이벤트가 아직 처리되지 않았거나 없는 회원)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 404,
                  "message": "존재하지 않는 지갑입니다.",
                  "data": null
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RsData": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        }
      },
      "CashWithdrawalRequestDto": {
        "type": "object",
        "description": "예치금 전액 환급 신청",
        "properties": {
          "bankCode": {
            "type": "string",
            "description": "은행 코드",
            "example": "004",
            "maxLength": 10,
            "minLength": 0
          },
          "accountNumber": {
            "type": "string",
            "description": "계좌번호",
            "example": "110123456789",
            "maxLength": 255,
            "minLength": 0
          },
          "accountHolder": {
            "type": "string",
            "description": "예금주명",
            "example": "홍길동",
            "maxLength": 50,
            "minLength": 0
          }
        },
        "required": [
          "accountHolder",
          "accountNumber",
          "bankCode"
        ]
      },
      "CashChargeConfirmRequestDto": {
        "type": "object",
        "description": "충전 승인 확정 요청",
        "properties": {
          "paymentKey": {
            "type": "string",
            "description": "Toss 결제 키",
            "example": "5EnNZRJGvaBd3GirPNB6s",
            "minLength": 1
          },
          "orderId": {
            "type": "string",
            "description": "충전 요청 고유 ID (멱등키)",
            "example": "charge-1697000000000",
            "minLength": 1
          },
          "amount": {
            "type": "integer",
            "format": "int32",
            "description": "충전 요청 금액 (최소 10,000원)",
            "example": 10000,
            "minimum": 0
          }
        },
        "required": [
          "amount",
          "orderId",
          "paymentKey"
        ]
      }
    }
  }
}

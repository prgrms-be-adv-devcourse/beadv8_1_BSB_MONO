{
  "openapi": "3.1.0",
  "info": {
    "title": "Bukang File API",
    "description": "크루 중심 마라톤 대회 예매·커머스 플랫폼 파일 API",
    "version": "v1"
  },
  "tags": [
    {
      "name": "File",
      "description": "이미지 업로드 URL 발급, 업로드 완료 확인, 파일 조회 API"
    }
  ],
  "paths": {
    "/api/v1/file/files": {
      "get": {
        "tags": [
          "File"
        ],
        "summary": "대상별 파일 목록 조회",
        "description": "대상(대회 등)에 연결된 파일을 용도(fileType: 대표 이미지 → 소개 이미지 → 코스 → 키트 → 소개 영상 → 명단) → 노출 순서(sortNo) 순으로 돌려준다. 이미지 URL은 30분 뒤 만료되는 presigned GET URL이다.",
        "operationId": "findByRef",
        "parameters": [
          {
            "name": "refType",
            "in": "query",
            "description": "대상 종류 (대상 엔티티 클래스 이름)",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Race"
          },
          {
            "name": "refId",
            "in": "query",
            "description": "대상 ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "파일 목록을 조회했습니다.",
                  "data": [
                    {
                      "id": 1,
                      "createDate": "2026-10-09T21:25:35",
                      "modifyDate": "2026-10-09T21:30:00",
                      "createUser": 1,
                      "originFileName": "race-thumbnail.png",
                      "contentType": "image/png",
                      "fileSize": 204800,
                      "status": "ACTIVE",
                      "refType": "Race",
                      "refId": 1,
                      "fileType": "THUMBNAIL",
                      "sortNo": 0,
                      "url": "https://crewrun-file-dev.s3.ap-northeast-2.amazonaws.com/files/3f2a9c1e-7b4d-4e8a-9c0f-1a2b3c4d5e6f.png?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Expires=1800&X-Amz-Signature=..."
                    },
                    {
                      "id": 2,
                      "createDate": "2026-10-09T21:27:00",
                      "modifyDate": "2026-10-09T21:30:00",
                      "createUser": 1,
                      "originFileName": "race-intro.png",
                      "contentType": "image/png",
                      "fileSize": 512000,
                      "status": "ACTIVE",
                      "refType": "Race",
                      "refId": 1,
                      "fileType": "DETAIL",
                      "sortNo": 0,
                      "url": "https://crewrun-file-dev.s3.ap-northeast-2.amazonaws.com/files/8c1d2e3f-4a5b-6c7d-8e9f-0a1b2c3d4e5f.png?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Expires=1800&X-Amz-Signature=..."
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "필수 요청 값 없음 또는 대상 ID 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "examples": {
                  "필수 요청 값 없음": {
                    "description": "필수 요청 값 없음",
                    "value": {
                      "status": 400,
                      "message": "필수 요청 값이 없습니다.",
                      "data": null
                    }
                  },
                  "대상 ID 형식 오류": {
                    "description": "대상 ID 형식 오류",
                    "value": {
                      "status": 400,
                      "message": "요청 값의 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "File"
        ],
        "summary": "업로드 URL 발급",
        "description": "파일 용도(fileType)에 맞는 형식과 크기를 검사한 뒤 파일을 업로드 대기 상태로 만들고, S3에 직접 올릴 presigned PUT URL(10분)을 발급한다. 브라우저는 응답의 headers를 그대로 붙여 PUT 한다. 이미지(THUMBNAIL, DETAIL, COURSE, KIT)는 JPG·PNG·WebP 10MB, 동영상(INTRO_VIDEO)은 MP4·MOV 100MB, 엑셀(ROSTER)은 XLSX·XLS 5MB 이하만 받는다.",
        "operationId": "createUploadUrl",
        "parameters": [
          {
            "name": "X-Member-Id",
            "in": "header",
            "description": "요청한 회원 ID (게이트웨이가 넣어 줄 예정)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileUploadRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "발급 성공",
            "content": {
              "application/json": {
                "example": {
                  "status": 201,
                  "message": "업로드 URL을 발급했습니다.",
                  "data": {
                    "fileId": 1,
                    "uploadUrl": "https://crewrun-file-dev.s3.ap-northeast-2.amazonaws.com/files/3f2a9c1e-7b4d-4e8a-9c0f-1a2b3c4d5e6f.png?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Date=20261009T122535Z&X-Amz-SignedHeaders=content-length%3Bcontent-type%3Bhost&X-Amz-Expires=600&X-Amz-Credential=AKIA...%2F20261009%2Fap-northeast-2%2Fs3%2Faws4_request&X-Amz-Signature=...",
                    "method": "PUT",
                    "headers": {
                      "content-length": "204800",
                      "content-type": "image/png"
                    },
                    "expiresAt": "2026-10-09T12:35:35Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "입력값 검증 실패, 요청 본문 형식 오류, 용도에 맞지 않는 형식, 크기 초과 또는 회원 ID 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "examples": {
                  "입력값 검증 실패": {
                    "description": "입력값 검증 실패",
                    "value": {
                      "status": 400,
                      "message": "파일명을 작성해주세요.",
                      "data": null
                    }
                  },
                  "요청 본문 형식 오류": {
                    "description": "요청 본문 형식 오류",
                    "value": {
                      "status": 400,
                      "message": "요청 본문 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  },
                  "용도에 맞지 않는 형식": {
                    "description": "용도에 맞지 않는 형식",
                    "value": {
                      "status": 400,
                      "message": "이미지 파일은 JPG, PNG, WebP만 올릴 수 있습니다.",
                      "data": null
                    }
                  },
                  "크기 초과": {
                    "description": "크기 초과",
                    "value": {
                      "status": 400,
                      "message": "이미지 파일은 10MB 이하만 올릴 수 있습니다.",
                      "data": null
                    }
                  },
                  "회원 ID 형식 오류": {
                    "description": "회원 ID 형식 오류",
                    "value": {
                      "status": 400,
                      "message": "요청 값의 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "회원 ID 헤더 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 401,
                  "message": "로그인이 필요합니다.",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/file/files/{fileId}/complete": {
      "post": {
        "tags": [
          "File"
        ],
        "summary": "업로드 완료 확인",
        "description": "S3에 올라간 파일의 크기와 앞부분(매직 바이트)이 발급 때 신고한 크기·형식과 같은지 확인해 업로드 완료로 바꾸고, 이미지를 볼 수 있는 presigned GET URL(30분)을 돌려준다. 다르면 올라간 파일을 지운다. 이미 확인한 파일은 같은 결과를 돌려준다.",
        "operationId": "completeUpload",
        "parameters": [
          {
            "name": "X-Member-Id",
            "in": "header",
            "description": "요청한 회원 ID (게이트웨이가 넣어 줄 예정)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          },
          {
            "name": "fileId",
            "in": "path",
            "description": "업로드 URL 발급 때 받은 파일 ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "확인 성공",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "업로드를 확인했습니다.",
                  "data": {
                    "id": 1,
                    "createDate": "2026-10-09T21:25:35",
                    "modifyDate": "2026-10-09T21:26:10",
                    "createUser": 1,
                    "originFileName": "race-thumbnail.png",
                    "contentType": "image/png",
                    "fileSize": 204800,
                    "status": "UPLOADED",
                    "refType": null,
                    "refId": null,
                    "fileType": "THUMBNAIL",
                    "sortNo": 0,
                    "url": "https://crewrun-file-dev.s3.ap-northeast-2.amazonaws.com/files/3f2a9c1e-7b4d-4e8a-9c0f-1a2b3c4d5e6f.png?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Expires=1800&X-Amz-Signature=..."
                  }
                }
              }
            }
          },
          "400": {
            "description": "업로드 안 됨, 신고한 형식·크기와 다름 또는 파일 ID·회원 ID 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "examples": {
                  "업로드 안 됨": {
                    "description": "업로드 안 됨",
                    "value": {
                      "status": 400,
                      "message": "업로드된 파일이 없습니다. 업로드 URL로 파일을 먼저 올려주세요.",
                      "data": null
                    }
                  },
                  "신고한 형식·크기와 다름": {
                    "description": "신고한 형식·크기와 다름",
                    "value": {
                      "status": 400,
                      "message": "올린 파일이 신고한 형식이나 크기와 다릅니다. 업로드 URL을 다시 받아 올려주세요.",
                      "data": null
                    }
                  },
                  "파일 ID·회원 ID 형식 오류": {
                    "description": "파일 ID·회원 ID 형식 오류",
                    "value": {
                      "status": 400,
                      "message": "요청 값의 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "회원 ID 헤더 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 401,
                  "message": "로그인이 필요합니다.",
                  "data": null
                }
              }
            }
          },
          "403": {
            "description": "다른 회원이 올린 파일",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 403,
                  "message": "본인이 올린 파일만 처리할 수 있습니다.",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "없거나 삭제된 파일",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 404,
                  "message": "존재하지 않는 파일입니다.",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/file/files/{fileId}": {
      "get": {
        "tags": [
          "File"
        ],
        "summary": "파일 조회",
        "description": "파일 정보와 이미지 URL을 돌려준다. 대상에 연결된 파일은 누구나, 연결 전 파일은 올린 회원만 볼 수 있다. 업로드를 확인하기 전 파일은 URL이 null이다.",
        "operationId": "findById",
        "parameters": [
          {
            "name": "X-Member-Id",
            "in": "header",
            "description": "요청한 회원 ID (연결 전 파일을 볼 때 필요)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          },
          {
            "name": "fileId",
            "in": "path",
            "description": "파일 ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "파일을 조회했습니다.",
                  "data": {
                    "id": 1,
                    "createDate": "2026-10-09T21:25:35",
                    "modifyDate": "2026-10-09T21:30:00",
                    "createUser": 1,
                    "originFileName": "race-thumbnail.png",
                    "contentType": "image/png",
                    "fileSize": 204800,
                    "status": "ACTIVE",
                    "refType": "Race",
                    "refId": 1,
                    "fileType": "THUMBNAIL",
                    "sortNo": 0,
                    "url": "https://crewrun-file-dev.s3.ap-northeast-2.amazonaws.com/files/3f2a9c1e-7b4d-4e8a-9c0f-1a2b3c4d5e6f.png?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Expires=1800&X-Amz-Signature=..."
                  }
                }
              }
            }
          },
          "400": {
            "description": "파일 ID·회원 ID 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 400,
                  "message": "요청 값의 형식이 올바르지 않습니다.",
                  "data": null
                }
              }
            }
          },
          "403": {
            "description": "다른 회원이 올린, 연결 전 파일",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 403,
                  "message": "연결된 파일이 아닙니다(현재 상태: 업로드 완료). 본인이 올린 파일만 볼 수 있습니다.",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "없거나 삭제된 파일",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 404,
                  "message": "존재하지 않는 파일입니다.",
                  "data": null
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FileUploadRequestDto": {
        "type": "object",
        "description": "업로드 URL 발급 요청",
        "properties": {
          "fileType": {
            "type": "string",
            "description": "파일 용도. 용도마다 받을 수 있는 파일 종류와 크기가 정해져 있다",
            "enum": [
              "THUMBNAIL",
              "DETAIL",
              "COURSE",
              "KIT",
              "INTRO_VIDEO",
              "ROSTER"
            ],
            "example": "THUMBNAIL"
          },
          "fileName": {
            "type": "string",
            "description": "원본 파일명 (255자 이하)",
            "example": "race-thumbnail.png",
            "maxLength": 255,
            "minLength": 0
          },
          "contentType": {
            "type": "string",
            "description": "파일 형식 (MIME 타입, 브라우저 File.type 값). 이미지 JPG·PNG·WebP, 동영상 MP4·MOV, 엑셀 XLSX·XLS",
            "example": "image/png",
            "minLength": 1
          },
          "fileSize": {
            "type": "integer",
            "format": "int64",
            "description": "파일 크기 (바이트). 이미지 10MB, 동영상 100MB, 엑셀 5MB 이하",
            "example": 204800,
            "minimum": 0
          }
        },
        "required": [
          "contentType",
          "fileName",
          "fileSize",
          "fileType"
        ]
      },
      "RsData": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        }
      }
    }
  }
}

{
  "responses": {
    "apply": {
      "201": {
        "wrapper": "RsDataParticipationDto",
        "data": {
          "$ref": "#/components/schemas/ParticipationDto"
        }
      }
    },
    "changeParticipant": {
      "200": {
        "wrapper": "RsDataParticipationDto",
        "data": {
          "$ref": "#/components/schemas/ParticipationDto"
        }
      }
    },
    "findLatestParticipant": {
      "200": {
        "wrapper": "RsDataParticipantInfoDto",
        "data": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/ParticipantInfoDto"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "create": {
      "201": {
        "wrapper": "RsDataOrderDto",
        "data": {
          "$ref": "#/components/schemas/OrderDto"
        }
      },
      "200": {
        "wrapper": "RsDataOrderDto",
        "data": {
          "$ref": "#/components/schemas/OrderDto"
        }
      }
    },
    "findById_1": {
      "200": {
        "wrapper": "RsDataOrderDto",
        "data": {
          "$ref": "#/components/schemas/OrderDto"
        }
      }
    },
    "pay": {
      "200": {
        "wrapper": "RsDataOrderDto",
        "data": {
          "$ref": "#/components/schemas/OrderDto"
        }
      }
    },
    "extendDeadline": {
      "200": {
        "wrapper": "RsDataOrderDto",
        "data": {
          "$ref": "#/components/schemas/OrderDto"
        }
      }
    },
    "findCart": {
      "200": {
        "wrapper": "RsDataCartDto",
        "data": {
          "$ref": "#/components/schemas/CartDto"
        }
      }
    },
    "removeItem": {
      "200": {
        "wrapper": "RsDataCartDto",
        "data": {
          "$ref": "#/components/schemas/CartDto"
        }
      }
    },
    "addItem": {
      "201": {
        "wrapper": "RsDataCartItemDto",
        "data": {
          "$ref": "#/components/schemas/CartItemDto"
        }
      },
      "200": {
        "wrapper": "RsDataCartItemDto",
        "data": {
          "$ref": "#/components/schemas/CartItemDto"
        }
      }
    },
    "checkout": {
      "200": {
        "wrapper": "RsDataCartCheckoutDto",
        "data": {
          "$ref": "#/components/schemas/CartCheckoutDto"
        }
      }
    }
  },
  "schemas": {
    "ShippingAddressDto": {
      "type": "object",
      "properties": {
        "recipientName": {
          "type": "string"
        },
        "recipientPhone": {
          "type": "string"
        },
        "zipcode": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "addressDetail": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "키트 배송지"
    },
    "ParticipantInfoDto": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "birth": {
          "type": "string",
          "format": "date"
        },
        "gender": {
          "type": "string",
          "enum": [
            "MALE",
            "FEMALE"
          ]
        },
        "phone": {
          "type": "string"
        },
        "emergencyContactName": {
          "type": "string"
        },
        "emergencyContactPhone": {
          "type": "string"
        },
        "tshirtSize": {
          "type": [
            "string",
            "null"
          ]
        },
        "shippingAddress": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/ShippingAddressDto"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "참가자 정보"
    },
    "ParticipationDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32"
        },
        "createDate": {
          "type": "string",
          "format": "date-time"
        },
        "modifyDate": {
          "type": "string",
          "format": "date-time"
        },
        "raceId": {
          "type": "integer",
          "format": "int32"
        },
        "raceCourseId": {
          "type": "integer",
          "format": "int32"
        },
        "memberId": {
          "type": "integer",
          "format": "int32"
        },
        "participationType": {
          "type": "string",
          "enum": [
            "INDIVIDUAL",
            "CREW"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "APPLIED",
            "CONFIRMED",
            "RELEASED",
            "FAILED",
            "CANCELED"
          ]
        },
        "participant": {
          "$ref": "#/components/schemas/ParticipantInfoDto"
        },
        "thirdPartyConsent": {
          "type": "boolean"
        },
        "consentedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "paymentDueAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "description": "참가 신청"
    },
    "OrderItemDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32"
        },
        "participationId": {
          "type": "integer",
          "format": "int32"
        },
        "raceCourseId": {
          "type": "integer",
          "format": "int32"
        },
        "sellerId": {
          "type": "integer",
          "format": "int32"
        },
        "itemName": {
          "type": "string"
        },
        "unitPrice": {
          "type": "integer",
          "format": "int32"
        },
        "quantity": {
          "type": "integer",
          "format": "int32"
        },
        "amount": {
          "type": "integer",
          "format": "int32"
        },
        "status": {
          "type": "string",
          "enum": [
            "ORDERED",
            "PAID",
            "CANCELED"
          ]
        }
      },
      "description": "주문 상품"
    },
    "OrderDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32"
        },
        "createDate": {
          "type": "string",
          "format": "date-time"
        },
        "orderNo": {
          "type": "string"
        },
        "buyerId": {
          "type": "integer",
          "format": "int32"
        },
        "raceId": {
          "type": "integer",
          "format": "int32"
        },
        "status": {
          "type": "string",
          "enum": [
            "CREATED",
            "PAID",
            "PARTIAL_CANCELED",
            "CANCELED",
            "EXPIRED"
          ]
        },
        "totalAmount": {
          "type": "integer",
          "format": "int32"
        },
        "canceledAmount": {
          "type": "integer",
          "format": "int32"
        },
        "paymentDueAt": {
          "type": "string",
          "format": "date-time"
        },
        "paidAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "shippingAddress": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/ShippingAddressDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/OrderItemDto"
          }
        }
      },
      "description": "주문"
    },
    "CartItemDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32"
        },
        "createDate": {
          "type": "string",
          "format": "date-time"
        },
        "raceCourseId": {
          "type": "integer",
          "format": "int32"
        }
      },
      "description": "장바구니 항목"
    },
    "CartDto": {
      "type": "object",
      "properties": {
        "memberId": {
          "type": "integer",
          "format": "int32"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/CartItemDto"
          }
        }
      },
      "description": "장바구니"
    },
    "CartCheckoutItemDto": {
      "type": "object",
      "properties": {
        "participationId": {
          "type": "integer",
          "format": "int32"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "CREATED",
            "EXISTING",
            "SOLD_OUT",
            "FAILED"
          ],
          "description": "CREATED·EXISTING이면 order가 있다"
        },
        "message": {
          "type": "string"
        },
        "order": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/OrderDto"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "장바구니 결제 항목별 결과"
    },
    "CartCheckoutDto": {
      "type": "object",
      "properties": {
        "orderedCount": {
          "type": "integer",
          "format": "int32"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/CartCheckoutItemDto"
          }
        }
      },
      "description": "장바구니 결제 결과"
    }
  }
}

{
  "responses": {
    "getBalance": {
      "200": {
        "wrapper": "RsDataWalletBalanceDto",
        "data": {
          "$ref": "#/components/schemas/WalletBalanceDto"
        }
      }
    },
    "confirmWalletCharge": {
      "200": {
        "wrapper": "RsDataCashChargeDto",
        "data": {
          "$ref": "#/components/schemas/CashChargeDto"
        }
      }
    },
    "requestWithdrawal": {
      "200": {
        "wrapper": "RsDataCashWithdrawalDto",
        "data": {
          "$ref": "#/components/schemas/CashWithdrawalDto"
        }
      }
    },
    "getLedgers": {
      "200": {
        "wrapper": "RsDataPageDtoWalletLedgerItemDto",
        "data": {
          "$ref": "#/components/schemas/PageDtoWalletLedgerItemDto"
        }
      }
    }
  },
  "schemas": {
    "WalletBalanceDto": {
      "type": "object",
      "description": "지갑 잔액 조회 응답",
      "properties": {
        "holderId": {
          "type": "integer",
          "format": "int32"
        },
        "balance": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "CashChargeDto": {
      "type": "object",
      "description": "충전 승인 확정 결과. PG 승인이 거절돼도 200이고 outcome이 FAILED",
      "required": [
        "outcome",
        "balance"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "COMPLETED",
            "FAILED"
          ]
        },
        "balance": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "CashWithdrawalDto": {
      "type": "object",
      "description": "예치금 전액 환급 결과",
      "required": [
        "withdrawnAmount",
        "balance"
      ],
      "properties": {
        "withdrawnAmount": {
          "type": "integer",
          "format": "int32"
        },
        "balance": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "PageDtoWalletLedgerItemDto": {
      "type": "object",
      "description": "예치금 내역 한 페이지. 최신순",
      "required": [
        "content",
        "page",
        "size",
        "totalElements",
        "totalPages"
      ],
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/WalletLedgerItemDto"
          }
        },
        "page": {
          "type": "integer",
          "format": "int32",
          "description": "0부터 센다"
        },
        "size": {
          "type": "integer",
          "format": "int32"
        },
        "totalElements": {
          "type": "integer",
          "format": "int64"
        },
        "totalPages": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "WalletLedgerItemDto": {
      "type": "object",
      "description": "예치금 내역 한 줄. amount는 부호가 있다(출금·결제는 음수)",
      "required": [
        "category",
        "ledgerType",
        "amount",
        "balanceAfter",
        "createdAt",
        "refId"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "CHARGE",
            "PAYMENT",
            "REFUND",
            "WITHDRAWAL",
            "PAYOUT"
          ]
        },
        "ledgerType": {
          "type": "string",
          "enum": [
            "충전__PG결제_토스페이먼츠",
            "출금__통장입금",
            "사용__주문결제",
            "임시보관__주문결제",
            "정산지급__상품판매_수수료",
            "정산수령__상품판매_수수료",
            "정산지급__상품판매_대금",
            "정산수령__상품판매_대금",
            "환불__주문취소",
            "임시보관반환__주문취소",
            "출금취소__통장입금"
          ]
        },
        "amount": {
          "type": "integer",
          "format": "int32"
        },
        "balanceAfter": {
          "type": "integer",
          "format": "int32"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "refId": {
          "type": "integer",
          "format": "int32"
        }
      }
    }
  }
}

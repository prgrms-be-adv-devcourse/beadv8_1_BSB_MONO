{
  "responses": {
    "login": {
      "200": {
        "wrapper": "RsDataMemberLoginResponseDto",
        "data": {
          "$ref": "#/components/schemas/MemberLoginResponseDto"
        }
      }
    },
    "reissue": {
      "200": {
        "wrapper": "RsDataTokenReissueResponseDto",
        "data": {
          "$ref": "#/components/schemas/TokenReissueResponseDto"
        }
      }
    },
    "findMe": {
      "200": {
        "wrapper": "RsDataMemberDto",
        "data": {
          "$ref": "#/components/schemas/MemberDto"
        }
      }
    },
    "modifyMe": {
      "200": {
        "wrapper": "RsDataMemberDto",
        "data": {
          "$ref": "#/components/schemas/MemberDto"
        }
      }
    },
    "checkEmailAvailability": {
      "200": {
        "wrapper": "RsDataEmailAvailabilityResponseDto",
        "data": {
          "$ref": "#/components/schemas/EmailAvailabilityResponseDto"
        }
      }
    },
    "apply": {
      "201": {
        "wrapper": "RsDataSellerDto",
        "data": {
          "$ref": "#/components/schemas/SellerDto"
        }
      }
    },
    "findMine": {
      "200": {
        "wrapper": "RsDataSellerDto",
        "data": {
          "$ref": "#/components/schemas/SellerDto"
        }
      }
    },
    "approve": {
      "200": {
        "wrapper": "RsDataSellerDto",
        "data": {
          "$ref": "#/components/schemas/SellerDto"
        }
      }
    },
    "reject": {
      "200": {
        "wrapper": "RsDataSellerDto",
        "data": {
          "$ref": "#/components/schemas/SellerDto"
        }
      }
    },
    "findAll": {
      "200": {
        "wrapper": "RsDataListSellerDto",
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/SellerDto"
          }
        }
      }
    },
    "checkMyResult": {
      "200": {
        "wrapper": "RsDataSellerDto",
        "data": {
          "$ref": "#/components/schemas/SellerDto"
        }
      }
    },
    "findSocialSignup": {
      "200": {
        "wrapper": "RsDataSocialSignupInfoDto",
        "data": {
          "$ref": "#/components/schemas/SocialSignupInfoDto"
        }
      }
    },
    "socialJoin": {
      "201": {
        "wrapper": "RsDataMemberLoginResponseDto",
        "data": {
          "$ref": "#/components/schemas/MemberLoginResponseDto"
        }
      }
    },
    "issueSocialLinkTicket": {
      "201": {
        "wrapper": "RsDataSocialLinkTicketDto",
        "data": {
          "$ref": "#/components/schemas/SocialLinkTicketDto"
        }
      }
    },
    "unlinkSocialAccount": {
      "200": {
        "wrapper": "RsDataMemberDto",
        "data": {
          "$ref": "#/components/schemas/MemberDto"
        }
      }
    }
  },
  "schemas": {
    "MemberDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32"
        },
        "createDate": {
          "type": "string",
          "format": "date-time"
        },
        "modifyDate": {
          "type": "string",
          "format": "date-time"
        },
        "nickname": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "birthDate": {
          "type": "string",
          "format": "date"
        },
        "socialProviders": {
          "type": "array",
          "description": "연결된 소셜 로그인 제공자",
          "items": {
            "type": "string",
            "enum": [
              "KAKAO",
              "GOOGLE"
            ]
          }
        },
        "passwordSet": {
          "type": "boolean",
          "description": "비밀번호가 있으면 true. false면 소셜 로그인으로만 로그인한다"
        }
      }
    },
    "MemberLoginResponseDto": {
      "type": "object",
      "description": "로그인 응답",
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "Access Token. 인증이 필요한 요청에 Authorization: Bearer {accessToken} 헤더로 보낸다"
        },
        "member": {
          "$ref": "#/components/schemas/MemberDto",
          "description": "로그인한 회원"
        }
      }
    },
    "TokenReissueResponseDto": {
      "type": "object",
      "description": "토큰 재발급 응답",
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "새 Access Token. 인증이 필요한 요청에 Authorization: Bearer {accessToken} 헤더로 보낸다"
        }
      }
    },
    "EmailAvailabilityResponseDto": {
      "type": "object",
      "description": "이메일 사용 가능 여부 응답",
      "properties": {
        "available": {
          "type": "boolean",
          "description": "사용 가능하면 true, 이미 가입된 이메일이면 false",
          "example": true
        }
      }
    },
    "SellerDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32"
        },
        "memberId": {
          "type": "integer",
          "format": "int32"
        },
        "sellerType": {
          "type": "string",
          "enum": [
            "BUSINESS",
            "INDIVIDUAL"
          ]
        },
        "businessName": {
          "type": "string",
          "nullable": true
        },
        "businessNumber": {
          "type": "string",
          "nullable": true
        },
        "representativeName": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        },
        "rejectReason": {
          "type": "string",
          "nullable": true
        },
        "resultCheckedAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true,
          "description": "신청자가 결과를 처음 본 시각. 아직 안 봤거나 심사 중이면 null"
        }
      },
      "required": [
        "id",
        "memberId",
        "sellerType",
        "representativeName",
        "status",
        "requestedAt"
      ]
    },
    "SocialSignupInfoDto": {
      "type": "object",
      "description": "소셜 가입 화면에 미리 채울 값",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "KAKAO",
            "GOOGLE"
          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "description": "제공자가 준 확인된 이메일. 없으면 null"
        },
        "emailLocked": {
          "type": "boolean",
          "description": "true면 이메일을 고칠 수 없다(제공자가 확인한 이메일)"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "제공자가 준 이름. 없으면 null"
        }
      },
      "required": [
        "provider",
        "emailLocked"
      ]
    },
    "SocialLinkTicketDto": {
      "type": "object",
      "description": "계정 연결 표",
      "properties": {
        "linkTicket": {
          "type": "string",
          "description": "2분 동안 한 번만 쓸 수 있는 연결 표"
        }
      },
      "required": [
        "linkTicket"
      ]
    }
  }
}

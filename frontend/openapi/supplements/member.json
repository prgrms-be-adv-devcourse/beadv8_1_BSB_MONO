{
  "responses": {
    "login": {
      "200": {
        "wrapper": "RsDataMemberLoginResponseDto",
        "data": {
          "$ref": "#/components/schemas/MemberLoginResponseDto"
        }
      }
    },
    "reissue": {
      "200": {
        "wrapper": "RsDataTokenReissueResponseDto",
        "data": {
          "$ref": "#/components/schemas/TokenReissueResponseDto"
        }
      }
    },
    "findMe": {
      "200": {
        "wrapper": "RsDataMemberDto",
        "data": {
          "$ref": "#/components/schemas/MemberDto"
        }
      }
    },
    "modifyMe": {
      "200": {
        "wrapper": "RsDataMemberDto",
        "data": {
          "$ref": "#/components/schemas/MemberDto"
        }
      }
    },
    "checkEmailAvailability": {
      "200": {
        "wrapper": "RsDataEmailAvailabilityResponseDto",
        "data": {
          "$ref": "#/components/schemas/EmailAvailabilityResponseDto"
        }
      }
    },
    "apply": {
      "201": {
        "wrapper": "RsDataSellerDto",
        "data": {
          "$ref": "#/components/schemas/SellerDto"
        }
      }
    },
    "findMine": {
      "200": {
        "wrapper": "RsDataSellerDto",
        "data": {
          "$ref": "#/components/schemas/SellerDto"
        }
      }
    },
    "approve": {
      "200": {
        "wrapper": "RsDataSellerDto",
        "data": {
          "$ref": "#/components/schemas/SellerDto"
        }
      }
    },
    "reject": {
      "200": {
        "wrapper": "RsDataSellerDto",
        "data": {
          "$ref": "#/components/schemas/SellerDto"
        }
      }
    },
    "findAll": {
      "200": {
        "wrapper": "RsDataListSellerDto",
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/SellerDto"
          }
        }
      }
    },
    "checkMyResult": {
      "200": {
        "wrapper": "RsDataSellerDto",
        "data": {
          "$ref": "#/components/schemas/SellerDto"
        }
      }
    },
    "createCrew": {
      "201": {
        "wrapper": "RsDataCrewHomeDto",
        "data": {
          "$ref": "#/components/schemas/CrewHomeDto"
        }
      }
    },
    "findMyCrews": {
      "200": {
        "wrapper": "RsDataListMyCrewDto",
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/MyCrewDto"
          }
        }
      }
    },
    "findCrew": {
      "200": {
        "wrapper": "RsDataCrewHomeDto",
        "data": {
          "$ref": "#/components/schemas/CrewHomeDto"
        }
      }
    },
    "createCrewInvite": {
      "201": {
        "wrapper": "RsDataCrewInviteCreatedDto",
        "data": {
          "$ref": "#/components/schemas/CrewInviteCreatedDto"
        }
      }
    },
    "findCrewInvites": {
      "200": {
        "wrapper": "RsDataListCrewInviteDto",
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/CrewInviteDto"
          }
        }
      }
    },
    "findCrewInvite": {
      "200": {
        "wrapper": "RsDataCrewInvitePreviewDto",
        "data": {
          "$ref": "#/components/schemas/CrewInvitePreviewDto"
        }
      }
    },
    "joinCrew": {
      "201": {
        "wrapper": "RsDataCrewJoinedDto",
        "data": {
          "$ref": "#/components/schemas/CrewJoinedDto"
        }
      }
    },
    "transferCrewLeader": {
      "200": {
        "wrapper": "RsDataCrewHomeDto",
        "data": {
          "$ref": "#/components/schemas/CrewHomeDto"
        }
      }
    }
  },
  "schemas": {
    "MemberDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32"
        },
        "createDate": {
          "type": "string",
          "format": "date-time"
        },
        "modifyDate": {
          "type": "string",
          "format": "date-time"
        },
        "nickname": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "birthDate": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "MemberLoginResponseDto": {
      "type": "object",
      "description": "로그인 응답",
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "Access Token. 인증이 필요한 요청에 Authorization: Bearer {accessToken} 헤더로 보낸다"
        },
        "member": {
          "$ref": "#/components/schemas/MemberDto",
          "description": "로그인한 회원"
        }
      }
    },
    "TokenReissueResponseDto": {
      "type": "object",
      "description": "토큰 재발급 응답",
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "새 Access Token. 인증이 필요한 요청에 Authorization: Bearer {accessToken} 헤더로 보낸다"
        }
      }
    },
    "EmailAvailabilityResponseDto": {
      "type": "object",
      "description": "이메일 사용 가능 여부 응답",
      "properties": {
        "available": {
          "type": "boolean",
          "description": "사용 가능하면 true, 이미 가입된 이메일이면 false",
          "example": true
        }
      }
    },
    "SellerDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32"
        },
        "memberId": {
          "type": "integer",
          "format": "int32"
        },
        "sellerType": {
          "type": "string",
          "enum": [
            "BUSINESS",
            "INDIVIDUAL"
          ]
        },
        "businessName": {
          "type": "string",
          "nullable": true
        },
        "businessNumber": {
          "type": "string",
          "nullable": true
        },
        "representativeName": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        },
        "rejectReason": {
          "type": "string",
          "nullable": true
        },
        "resultCheckedAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true,
          "description": "신청자가 결과를 처음 본 시각. 아직 안 봤거나 심사 중이면 null"
        }
      },
      "required": [
        "id",
        "memberId",
        "sellerType",
        "representativeName",
        "status",
        "requestedAt"
      ]
    },
    "CrewMemberDto": {
      "type": "object",
      "description": "크루원 (실명 없이 닉네임만)",
      "properties": {
        "memberId": {
          "type": "integer",
          "format": "int64"
        },
        "nickname": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "LEADER",
            "MANAGER",
            "MEMBER"
          ],
          "description": "크루 역할 (LEADER: 크루장, MANAGER: 운영진, MEMBER: 크루원)"
        }
      },
      "required": [
        "memberId",
        "nickname",
        "role"
      ]
    },
    "CrewHomeDto": {
      "type": "object",
      "description": "크루 홈",
      "properties": {
        "crewId": {
          "type": "integer",
          "format": "int64"
        },
        "name": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "myRole": {
          "type": "string",
          "enum": [
            "LEADER",
            "MANAGER",
            "MEMBER"
          ],
          "description": "요청한 회원의 역할. 크루 역할 (LEADER: 크루장, MANAGER: 운영진, MEMBER: 크루원)"
        },
        "memberCount": {
          "type": "integer",
          "format": "int32"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/CrewMemberDto"
          }
        }
      },
      "required": [
        "crewId",
        "name",
        "createdAt",
        "myRole",
        "memberCount",
        "members"
      ]
    },
    "MyCrewDto": {
      "type": "object",
      "description": "내 크루 목록의 크루 하나",
      "properties": {
        "crewId": {
          "type": "integer",
          "format": "int64"
        },
        "name": {
          "type": "string"
        },
        "myRole": {
          "type": "string",
          "enum": [
            "LEADER",
            "MANAGER",
            "MEMBER"
          ],
          "description": "크루 역할 (LEADER: 크루장, MANAGER: 운영진, MEMBER: 크루원)"
        },
        "memberCount": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "crewId",
        "name",
        "myRole",
        "memberCount"
      ]
    },
    "CrewInviteCreatedDto": {
      "type": "object",
      "description": "만든 초대 링크. inviteToken은 이 응답에서만 받는다",
      "properties": {
        "inviteId": {
          "type": "integer",
          "format": "int64"
        },
        "inviteToken": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "inviteId",
        "inviteToken",
        "createdAt",
        "expiresAt"
      ]
    },
    "CrewInviteSenderDto": {
      "type": "object",
      "properties": {
        "memberId": {
          "type": "integer",
          "format": "int64"
        },
        "nickname": {
          "type": "string"
        }
      },
      "required": [
        "memberId",
        "nickname"
      ]
    },
    "CrewInviteDto": {
      "type": "object",
      "description": "아직 쓸 수 있는 초대",
      "properties": {
        "inviteId": {
          "type": "integer",
          "format": "int64"
        },
        "createdBy": {
          "$ref": "#/components/schemas/CrewInviteSenderDto"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "inviteId",
        "createdBy",
        "createdAt",
        "expiresAt"
      ]
    },
    "CrewInvitePreviewDto": {
      "type": "object",
      "description": "초대 받기 화면 정보",
      "properties": {
        "crewId": {
          "type": "integer",
          "format": "int64"
        },
        "crewName": {
          "type": "string"
        },
        "memberCount": {
          "type": "integer",
          "format": "int32"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "alreadyMember": {
          "type": "boolean",
          "description": "요청한 회원이 이미 이 크루의 크루원인지"
        }
      },
      "required": [
        "crewId",
        "crewName",
        "memberCount",
        "expiresAt",
        "alreadyMember"
      ]
    },
    "CrewJoinedDto": {
      "type": "object",
      "description": "초대로 가입한 결과",
      "properties": {
        "crewId": {
          "type": "integer",
          "format": "int64"
        },
        "crewName": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "LEADER",
            "MANAGER",
            "MEMBER"
          ],
          "description": "크루 역할 (LEADER: 크루장, MANAGER: 운영진, MEMBER: 크루원)"
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "crewId",
        "crewName",
        "role",
        "joinedAt"
      ]
    }
  }
}

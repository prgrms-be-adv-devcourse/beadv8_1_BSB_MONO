{
  "openapi": "3.1.0",
  "info": {
    "title": "Bukang Payout API",
    "description": "크루 중심 마라톤 대회 예매·커머스 플랫폼 정산 API",
    "version": "v1"
  },
  "tags": [
    {
      "name": "Payout",
      "description": "지급보류 걸기, 지급보류 풀기 API (관리자)"
    },
    {
      "name": "PayoutInternal",
      "description": "참가권 환불 가능 여부 조회 API (서비스 간 내부 호출 전용)"
    },
    {
      "name": "PayoutSeller",
      "description": "정산 요약, 정산 내역, 건별 정산, 지급보류 내역 조회 API (판매자)"
    },
    {
      "name": "PayoutRecovery",
      "description": "회수 완료 API (관리자)"
    }
  ],
  "paths": {
    "/api/v1/payout/recoveries/{recoveryId}/complete": {
      "post": {
        "tags": [
          "PayoutRecovery"
        ],
        "summary": "회수 완료",
        "description": "판매자의 입금을 확인한 회수를 회수 완료(COMPLETED)로 바꾸고 확인한 관리자와 일시를 남긴다.",
        "operationId": "complete",
        "parameters": [
          {
            "name": "X-Member-Id",
            "in": "header",
            "description": "요청한 관리자 회원 ID (게이트웨이가 넣어 줄 예정)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          },
          {
            "name": "recoveryId",
            "in": "path",
            "description": "회수 ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "완료 성공",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "회수를 완료했습니다.",
                  "data": {
                    "id": 1,
                    "sellerId": 1,
                    "raceId": 10,
                    "reasonType": "RACE_CANCELED",
                    "amount": 40000,
                    "status": "COMPLETED",
                    "requestedAt": "2026-10-15T14:00:00",
                    "completedBy": 1,
                    "completedAt": "2026-10-20T10:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "회수 ID·회원 ID 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 400,
                  "message": "요청 값의 형식이 올바르지 않습니다.",
                  "data": null
                }
              }
            }
          },
          "401": {
            "description": "회원 ID 헤더 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 401,
                  "message": "로그인이 필요합니다.",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "없는 회수",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 404,
                  "message": "회수를 찾을 수 없습니다.",
                  "data": null
                }
              }
            }
          },
          "409": {
            "description": "이미 완료됨",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 409,
                  "message": "이미 완료된 회수입니다.",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payout/payouts/{payoutId}/holds": {
      "post": {
        "tags": [
          "Payout"
        ],
        "summary": "지급보류 걸기",
        "description": "정산 예정(CALCULATED)인 정산 내역에 지급보류를 걸어 지급 배치에서 지급되지 않게 한다. 한 정산 내역에는 보류를 하나만 걸 수 있고, 지급보류 ID(HD-)를 붙인다.",
        "operationId": "hold",
        "parameters": [
          {
            "name": "X-Member-Id",
            "in": "header",
            "description": "요청한 관리자 회원 ID (게이트웨이가 넣어 줄 예정)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          },
          {
            "name": "payoutId",
            "in": "path",
            "description": "정산 내역 ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PayoutHoldRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "보류 성공",
            "content": {
              "application/json": {
                "example": {
                  "status": 201,
                  "message": "지급보류를 걸었습니다.",
                  "data": {
                    "id": 1,
                    "holdCode": "HD-20261012-0001",
                    "payoutId": 1,
                    "reasonType": "ACCOUNT_NOT_REGISTERED",
                    "reason": "정산 계좌 등록 요청 중",
                    "status": "HELD",
                    "heldBy": 1,
                    "heldAt": "2026-10-12T10:00:00",
                    "releasedBy": null,
                    "releasedAt": null
                  }
                }
              }
            }
          },
          "400": {
            "description": "입력값 검증 실패, 요청 본문 형식 오류 또는 정산 내역 ID·회원 ID 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "examples": {
                  "보류 사유 없음": {
                    "description": "보류 사유 없음",
                    "value": {
                      "status": 400,
                      "message": "보류 사유를 선택해주세요.",
                      "data": null
                    }
                  },
                  "사유 상세 500자 초과": {
                    "description": "사유 상세 500자 초과",
                    "value": {
                      "status": 400,
                      "message": "사유 상세는 500자 이하로 작성해주세요.",
                      "data": null
                    }
                  },
                  "요청 본문 형식 오류 (없는 사유 값 포함)": {
                    "description": "요청 본문 형식 오류 (없는 사유 값 포함)",
                    "value": {
                      "status": 400,
                      "message": "요청 본문 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  },
                  "정산 내역 ID·회원 ID 형식 오류": {
                    "description": "정산 내역 ID·회원 ID 형식 오류",
                    "value": {
                      "status": 400,
                      "message": "요청 값의 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "회원 ID 헤더 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 401,
                  "message": "로그인이 필요합니다.",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "없는 정산 내역",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 404,
                  "message": "정산 내역을 찾을 수 없습니다.",
                  "data": null
                }
              }
            }
          },
          "409": {
            "description": "이미 보류 중, 이미 지급 완료, 대회 취소로 닫힘 또는 다른 요청과 동시 수정",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "examples": {
                  "이미 보류 중": {
                    "description": "이미 보류 중",
                    "value": {
                      "status": 409,
                      "message": "이미 지급보류 중인 정산 내역입니다.",
                      "data": null
                    }
                  },
                  "이미 지급 완료": {
                    "description": "이미 지급 완료",
                    "value": {
                      "status": 409,
                      "message": "이미 지급 완료된 정산 내역입니다.",
                      "data": null
                    }
                  },
                  "대회 취소로 닫힘": {
                    "description": "대회 취소로 닫힘",
                    "value": {
                      "status": 409,
                      "message": "취소된 정산 내역입니다.",
                      "data": null
                    }
                  },
                  "동시 수정": {
                    "description": "동시 수정",
                    "value": {
                      "status": 409,
                      "message": "다른 요청이 먼저 정산 내역을 바꿨습니다. 다시 시도해주세요.",
                      "data": null
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payout/holds/{holdId}/release": {
      "post": {
        "tags": [
          "Payout"
        ],
        "summary": "지급보류 풀기",
        "description": "지급보류를 해제하고 정산 내역을 정산 예정(CALCULATED)으로 돌린다. 지급 예정일은 다시 정한다. 1차 · 최종 모두 해제일 다음 날(주말에도 지급)이며, 원래 지급 예정일(정산 월의 다음 달 20일, 휴일이면 다음 영업일)보다 앞당기지 않는다.",
        "operationId": "release",
        "parameters": [
          {
            "name": "X-Member-Id",
            "in": "header",
            "description": "요청한 관리자 회원 ID (게이트웨이가 넣어 줄 예정)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          },
          {
            "name": "holdId",
            "in": "path",
            "description": "지급보류 ID (보류 걸기 응답의 id)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "해제 성공",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "지급보류를 풀었습니다.",
                  "data": {
                    "id": 1,
                    "holdCode": "HD-20261012-0001",
                    "payoutId": 1,
                    "reasonType": "ACCOUNT_NOT_REGISTERED",
                    "reason": "정산 계좌 등록 요청 중",
                    "status": "RELEASED",
                    "heldBy": 1,
                    "heldAt": "2026-10-12T10:00:00",
                    "releasedBy": 1,
                    "releasedAt": "2026-10-15T09:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "지급보류 ID·회원 ID 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 400,
                  "message": "요청 값의 형식이 올바르지 않습니다.",
                  "data": null
                }
              }
            }
          },
          "401": {
            "description": "회원 ID 헤더 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 401,
                  "message": "로그인이 필요합니다.",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "없는 지급보류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 404,
                  "message": "지급보류를 찾을 수 없습니다.",
                  "data": null
                }
              }
            }
          },
          "409": {
            "description": "이미 해제됨, 대회 취소로 닫힌 정산 내역 또는 다른 요청과 동시 수정",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "examples": {
                  "이미 해제됨": {
                    "description": "이미 해제됨",
                    "value": {
                      "status": 409,
                      "message": "이미 해제된 지급보류입니다.",
                      "data": null
                    }
                  },
                  "대회 취소로 닫힘": {
                    "description": "대회 취소로 닫힘",
                    "value": {
                      "status": 409,
                      "message": "취소된 정산 내역의 지급보류는 풀 수 없습니다.",
                      "data": null
                    }
                  },
                  "동시 수정": {
                    "description": "동시 수정",
                    "value": {
                      "status": 409,
                      "message": "다른 요청이 먼저 정산 내역을 바꿨습니다. 다시 시도해주세요.",
                      "data": null
                    }
                  }
                }
              }
            }
          }
        }
      }

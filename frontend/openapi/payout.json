    "/internal/v1/payout/refund-eligibility": {
      "get": {
        "tags": [
          "PayoutInternal"
        ],
        "summary": "참가권 환불 가능 여부 조회",
        "description": "대회일로 정산 대상일(대회 다음 날)을 구해, 오늘(한국 날짜)이 정산 대상일 전이면 환불 가능으로 돌려준다. 정산 대상일 당일부터는 사유와 상관없이(대회 취소·일정 변경 포함) 환불할 수 없다. 환불 기한 판단은 주문 서비스가 하고, 환불 요청을 받을 때 이 API를 동기 호출로 부른다.",
        "operationId": "refundEligibility",
        "parameters": [
          {
            "name": "raceDate",
            "in": "query",
            "description": "참가권의 대회일 (yyyy-MM-dd)",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-09-25"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공 (환불 가능 여부는 data.refundable)",
            "content": {
              "application/json": {
                "examples": {
                  "환불 가능": {
                    "description": "환불 가능",
                    "value": {
                      "status": 200,
                      "message": "환불 가능 여부를 조회했습니다.",
                      "data": {
                        "raceDate": "2026-09-25",
                        "payoutTargetDate": "2026-09-26",
                        "refundable": true
                      }
                    }
                  },
                  "환불 불가 (정산 대상일 지남)": {
                    "description": "환불 불가 (정산 대상일 지남)",
                    "value": {
                      "status": 200,
                      "message": "환불 가능 여부를 조회했습니다.",
                      "data": {
                        "raceDate": "2026-09-25",
                        "payoutTargetDate": "2026-09-26",
                        "refundable": false
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "대회일 없음 또는 대회일 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "examples": {
                  "대회일 없음": {
                    "description": "대회일 없음",
                    "value": {
                      "status": 400,
                      "message": "필수 요청 값이 없습니다.",
                      "data": null
                    }
                  },
                  "대회일 형식 오류": {
                    "description": "대회일 형식 오류",
                    "value": {
                      "status": 400,
                      "message": "요청 값의 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payout/seller/summary": {
      "get": {

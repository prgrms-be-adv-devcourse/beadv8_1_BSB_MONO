    "/api/v1/payout/seller/payouts": {
      "get": {
        "tags": [
          "PayoutSeller"
        ],
        "summary": "정산 내역 조회",
        "description": "정산 월(정산 대상일이 속한 달)이 기간 안인 정산 내역을 최근 달부터 돌려준다. 시작 달을 포함해 최대 12개월까지 한 번에 조회한다.",
        "operationId": "payouts",
        "parameters": [
          {
            "name": "X-Member-Id",
            "in": "header",
            "description": "판매자 회원 ID (게이트웨이가 넣어 줄 예정)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          },
          {
            "name": "fromMonth",
            "in": "query",
            "description": "조회 시작 정산 월 (yyyy-MM)",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "2025-11"

                  "요청 본문 형식 오류": {
                    "description": "요청 본문 형식 오류",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "요청 본문 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  },
                  "만 14세 미만": {
                    "description": "만 14세 미만",
                    "value": {
                      "status": 400,
                      "code": "MEMBER_UNDER_AGE",
                      "message": "만 14세 미만의 생년월일로는 수정할 수 없습니다.",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "회원 ID 헤더 없음 (로그인하지 않은 요청)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 401,
                  "message": "로그인이 필요합니다.",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "헤더의 회원이 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 404,
                  "message": "존재하지 않는 회원입니다.",
                  "data": null
                }
              }
            }
          },
          "409": {
            "description": "다른 회원이 쓰는 닉네임 또는 휴대폰 번호",
            "content": {

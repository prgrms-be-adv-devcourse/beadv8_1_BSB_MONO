{
  "openapi": "3.1.0",
  "info": {
    "title": "Bukang Member API",
    "description": "크루 중심 마라톤 대회 예매·커머스 플랫폼 API",
    "version": "v1"
  },
  "tags": [
    {
      "name": "Member",
      "description": "이메일 중복 확인, 내 정보 조회, 내 정보 수정 API"
    },
    {
      "name": "Auth",
      "description": "회원가입, 로그인, 토큰 재발급, 로그아웃 API"
    }
  ],
  "paths": {
    "/api/v1/member/members/me": {
      "get": {
        "tags": [
          "Member"
        ],
        "summary": "내 정보 조회",
        "description": "게이트웨이가 Access Token에서 꺼내 넣은 회원 ID(X-Member-Id 헤더)로 로그인한 회원의 정보를 조회한다.",
        "operationId": "findMe",
        "parameters": [
          {
            "name": "X-Member-Id",
            "in": "header",
            "description": "로그인한 회원 ID (게이트웨이가 Access Token에서 꺼내 넣는다)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "내 정보를 조회했습니다.",
                  "data": {
                    "id": 1,
                    "createDate": "2026-10-05T21:25:35",
                    "modifyDate": "2026-10-05T21:25:35",
                    "nickname": "러너1",
                    "email": "runner1@crewrun.com",
                    "phone": "010-1234-5678",
                    "name": "김러너",
                    "birthDate": "1995-04-12"
                  }
                }
              }
            }
          },
          "401": {
            "description": "회원 ID 헤더 없음 (로그인하지 않은 요청)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 401,
                  "message": "로그인이 필요합니다.",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "헤더의 회원이 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 404,
                  "message": "존재하지 않는 회원입니다.",
                  "data": null
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Member"
        ],
        "summary": "내 정보 수정",
        "description": "X-Member-Id 헤더의 회원의 이름, 생년월일, 휴대폰 번호, 닉네임을 바꾼다. 다른 회원이 쓰는 닉네임·휴대폰 번호인지 검사하고(내 행은 제외, 휴대폰은 하이픈 유무 무관), 4칸이 모두 그대로면 저장하지 않는다.",
        "operationId": "modifyMe",
        "parameters": [
          {
            "name": "X-Member-Id",
            "in": "header",
            "description": "로그인한 회원 ID (게이트웨이가 Access Token에서 꺼내 넣는다)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberModifyRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "수정 성공 (바뀐 게 없어도 200)",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "내 정보를 수정했습니다.",
                  "data": {
                    "id": 1,
                    "createDate": "2026-10-05T21:25:35",
                    "modifyDate": "2026-10-15T10:12:08",
                    "nickname": "러너2",
                    "email": "runner1@crewrun.com",
                    "phone": "010-9876-5432",
                    "name": "김러너",
                    "birthDate": "1995-04-12"
                  }
                }
              }
            }
          },
          "400": {
            "description": "입력값 검증 실패, 요청 본문 형식 오류 또는 만 14세 미만",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "examples": {
                  "입력값 검증 실패": {
                    "description": "입력값 검증 실패",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "휴대폰 번호 형식에 맞게 작성해주세요.",
                      "data": null

    },
    {
      "name": "Auth",
      "description": "회원가입, 로그인, 토큰 재발급, 로그아웃 API"
    },
    {
      "name": "AdminSeller",
      "description": "판매자 신청 목록, 승인, 반려 API (관리자 전용)"
    },
    {
      "name": "Seller",
      "description": "판매자 등록 신청, 내 신청 조회 API"
    }
  ],

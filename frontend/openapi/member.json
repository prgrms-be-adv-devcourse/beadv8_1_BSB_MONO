    "/api/v1/member/members/email-availability": {
      "get": {
        "tags": [
          "Member"
        ],
        "summary": "이메일 사용 가능 여부 확인",
        "description": "이메일이 아직 가입되지 않았으면 available=true, 이미 가입됐으면 false를 돌려준다. 로그인 없이 부를 수 있다. 탈퇴한 회원의 이메일은 비워지므로 다시 쓸 수 있다.",
        "operationId": "checkEmailAvailability",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "description": "확인할 이메일",
            "required": true,
            "schema": {
              "type": "string",
              "format": "email",
              "maxLength": 255,
              "minLength": 1
            },
            "example": "runner1@crewrun.com"
          }
        ],
        "responses": {
          "200": {
            "description": "확인 성공 (이미 쓰는 이메일이어도 200)",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "이메일 사용 가능 여부를 확인했습니다.",
                  "data": {
                    "available": true
                  }
                }
              }
            }
          },
          "400": {
            "description": "이메일 누락, 형식 오류 또는 255자 초과",
            "content": {
              "application/json": {
                "schema": {

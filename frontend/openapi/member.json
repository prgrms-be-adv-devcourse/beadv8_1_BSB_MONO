{
  "openapi": "3.1.0",
  "info": {
    "title": "Bukang Member API",
    "description": "크루 중심 마라톤 대회 예매·커머스 플랫폼 API",
    "version": "v1"
  },
  "tags": [
    {
      "name": "Auth",
      "description": "회원가입, 로그인 API"
    },
    {
      "name": "Member",
      "description": "회원 정보 API"
    }
  ],
  "paths": {
    "/api/v1/auth/join": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "회원가입",
        "description": "이메일, 닉네임, 휴대폰 번호 중복을 검사한 뒤 회원을 생성한다.",
        "operationId": "join",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberJoinRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "가입 성공",
            "content": {
              "application/json": {
                "example": {
                  "status": 201,
                  "message": "Member Joined Successfully",
                  "data": {
                    "id": 1,
                    "createDate": "2026-10-05T21:25:35",
                    "modifyDate": "2026-10-05T21:25:35",
                    "nickname": "러너1",
                    "email": "runner1@crewrun.com"
                  }
                }
              }
            }
          },
          "400": {
            "description": "입력값 검증 실패 또는 요청 본문 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "examples": {
                  "입력값 검증 실패": {
                    "description": "입력값 검증 실패",
                    "value": {
                      "status": 400,
                      "message": "비밀번호는 10자 이상 작성해야합니다.",
                      "data": null
                    }
                  },
                  "요청 본문 형식 오류": {
                    "description": "요청 본문 형식 오류",
                    "value": {
                      "status": 400,
                      "message": "요청 본문 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "이메일, 닉네임 또는 휴대폰 번호 중복",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "examples": {
                  "이메일 중복": {
                    "description": "이메일 중복",
                    "value": {
                      "status": 409,
                      "message": "이미 사용 중인 이메일입니다.",
                      "data": null
                    }
                  },
                  "닉네임 중복": {
                    "description": "닉네임 중복",
                    "value": {
                      "status": 409,
                      "message": "이미 사용 중인 닉네임입니다.",
                      "data": null
                    }
                  },
                  "휴대폰 번호 중복": {
                    "description": "휴대폰 번호 중복",
                    "value": {
                      "status": 409,
                      "message": "이미 사용 중인 전화번호입니다.",
                      "data": null
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "로그인",
        "description": "이메일과 비밀번호로 로그인하고 세션에 인증 정보를 저장한다.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberLoginRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "로그인 성공",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "로그인 성공",
                  "data": {
                    "id": 1,
                    "createDate": "2026-10-05T21:25:35",
                    "modifyDate": "2026-10-05T21:25:35",
                    "nickname": "러너1",
                    "email": "runner1@crewrun.com"
                  }
                }
              }
            }
          },
          "400": {
            "description": "입력값 검증 실패 또는 요청 본문 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "examples": {
                  "입력값 검증 실패": {
                    "description": "입력값 검증 실패",
                    "value": {
                      "status": 400,
                      "message": "이메일을 입력해주세요.",
                      "data": null
                    }
                  },
                  "요청 본문 형식 오류": {
                    "description": "요청 본문 형식 오류",
                    "value": {
                      "status": 400,
                      "message": "요청 본문 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "이메일 또는 비밀번호 불일치",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 401,
                  "message": "이메일 또는 비밀번호가 올바르지 않습니다.",
                  "data": null
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MemberJoinRequestDto": {
        "type": "object",
        "description": "회원가입 요청",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "이메일 (로그인 ID)",
            "example": "runner1@crewrun.com",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "description": "비밀번호 (10자 이상)",
            "example": "password1234",
            "maxLength": 2147483647,
            "minLength": 10
          },
          "name": {
            "type": "string",
            "description": "실명",
            "example": "김러너",
            "minLength": 1
          },
          "nickname": {
            "type": "string",
            "description": "닉네임 (30자 이하)",
            "example": "러너1",
            "maxLength": 30,
            "minLength": 0
          },
          "phone": {
            "type": "string",
            "description": "휴대폰 번호 (하이픈 생략 가능)",
            "example": "010-1234-5678",
            "minLength": 1,
            "pattern": "^01[016789]-?\\d{3,4}-?\\d{4}$"
          },
          "birthDate": {
            "type": "string",
            "format": "date",
            "description": "생년월일",
            "example": "1995-04-12"
          },
          "gender": {
            "type": [
              "string",
              "null"
            ],
            "description": "성별 (선택)",
            "enum": [
              "MALE",
              "FEMALE"
            ],
            "example": "FEMALE"
          }
        },
        "required": [
          "birthDate",
          "email",
          "name",
          "nickname",
          "password",
          "phone"
        ]
      },
      "MemberLoginRequestDto": {
        "type": "object",
        "description": "로그인 요청",
        "properties": {
          "email": {
            "type": "string",
            "description": "이메일",
            "example": "runner1@crewrun.com",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "description": "비밀번호",
            "example": "password1234",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RsData": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        }
      }
    }
  }
}
